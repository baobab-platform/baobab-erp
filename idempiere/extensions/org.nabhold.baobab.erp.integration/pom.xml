<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.nabhold.baobab.erp</groupId>
    <artifactId>baobab-erp-extensions</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>org.nabhold.baobab.erp.integration</artifactId>
  <packaging>jar</packaging>

  <name>Baobab ERP Integration Bundle</name>
  <description>
    Shared library bundle used by the other Baobab OSGi extensions to reach the
    baobab-app HTTP service (modules/application/server.py) -- the boundary through
    which code running inside iDempiere's own JVM reaches the baobab Postgres schema,
    since it has no direct database access of its own. See ADR-ERP-005. Exports
    packages for other bundles to compile/import against; registers no OSGi service
    of its own.
  </description>

  <!-- Keep validator dependencies private in the shaded OSGi bundle. The
       existing iDempiere Jackson wiring must not select a different version. -->
  <dependencyManagement><dependencies><dependency>
    <groupId>com.fasterxml.jackson</groupId><artifactId>jackson-bom</artifactId>
    <version>2.22.3</version><type>pom</type><scope>import</scope>
  </dependency></dependencies></dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>com.networknt</groupId><artifactId>json-schema-validator</artifactId><version>3.0.8</version>
      <exclusions><exclusion><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <testResources><testResource>
      <directory>${project.basedir}/../../../tests/fixtures</directory>
      <includes><include>authority-contract-cases.json</include></includes>
    </testResource></testResources>
    <plugins>
      <!-- Preserve the bnd OSGi manifest, merge service descriptors, and retain
           meta-schema resources. No runtime dependency on external Jackson or
           validator bundles; packaged-JAR checks run with an isolated loader. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.2</version>
        <executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
          <createDependencyReducedPom>false</createDependencyReducedPom>
          <filters><filter><artifact>*:*</artifact><excludes>
            <exclude>META-INF/*.SF</exclude><exclude>META-INF/*.RSA</exclude><exclude>META-INF/*.DSA</exclude>
            <exclude>module-info.class</exclude><exclude>META-INF/versions/**/module-info.class</exclude>
          </excludes></filter></filters>
          <relocations>
            <relocation><pattern>com.networknt</pattern><shadedPattern>org.nabhold.baobab.erp.integration.internal.networknt</shadedPattern></relocation>
            <relocation><pattern>com.fasterxml.jackson</pattern><shadedPattern>org.nabhold.baobab.erp.integration.internal.jackson</shadedPattern></relocation>
            <relocation><pattern>com.ethlo</pattern><shadedPattern>org.nabhold.baobab.erp.integration.internal.ethlo</shadedPattern></relocation>
            <relocation><pattern>org.slf4j</pattern><shadedPattern>org.nabhold.baobab.erp.integration.internal.slf4j</shadedPattern></relocation>
          </relocations>
          <transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/></transformers>
        </configuration></execution></executions>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
        <configuration>
          <bnd><![CDATA[
Bundle-SymbolicName: org.nabhold.baobab.erp.integration
Bundle-Vendor: Nabhold Group Africa
Export-Package: org.nabhold.baobab.erp.integration
Import-Package: !com.networknt.*,!com.fasterxml.jackson.*,!com.ethlo.*,!org.slf4j.*,*
]]></bnd>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
