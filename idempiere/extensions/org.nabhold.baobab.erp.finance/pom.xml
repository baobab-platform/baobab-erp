<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.nabhold.baobab.erp</groupId>
    <artifactId>baobab-erp-extensions</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>org.nabhold.baobab.erp.finance</artifactId>
  <packaging>jar</packaging>
  <name>Baobab ERP Native Financial Veto</name>
  <dependencies>
    <dependency><groupId>org.osgi</groupId><artifactId>org.osgi.core</artifactId></dependency>
    <dependency><groupId>org.osgi</groupId><artifactId>org.osgi.util.tracker</artifactId></dependency>
    <dependency><groupId>org.nabhold.baobab.erp</groupId><artifactId>org.nabhold.baobab.erp.integration</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId></dependency>
  </dependencies>
  <build><plugins>
    <plugin>
      <groupId>biz.aQute.bnd</groupId><artifactId>bnd-maven-plugin</artifactId>
      <configuration><bnd><![CDATA[
Bundle-SymbolicName: org.nabhold.baobab.erp.finance
Bundle-Activator: org.nabhold.baobab.erp.finance.FinanceActivator
Bundle-Vendor: Nabhold Group Africa
Export-Package: org.nabhold.baobab.erp.finance
Import-Package: org.nabhold.baobab.erp.integration;version="[0.1,1)",*
DynamicImport-Package: org.compiere.model,org.compiere.util
]]></bnd></configuration>
    </plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId></plugin>
  </plugins></build>
</project>
