{
  "name": "Baobab ERP",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/baobab-erp",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "postCreateCommand": "printf 'ERP Codespace ready; run bash scripts/dev/bootstrap.sh when needed\\n'",
  "runServices": [],
  "waitFor": "postCreateCommand",
  "init": true,
  "updateRemoteUserUID": true
}
