# Copy to .env. Never commit the populated file.
IDEMPIERE_IMAGE=idempiereofficial/idempiere:13-release
IDEMPIERE_IMAGE_TAG=baobab-idempiere:local
IDEMPIERE_HTTPS_PORT=8443
BAOBAB_APP_IMAGE_TAG=baobab-app:local
BAOBAB_APP_PORT=8000
DB_NAME=idempiere
DB_USER=adempiere
DB_PASS=change-me-database
DB_ADMIN_PASS=change-me-admin
# Verifies signed events on modules/application's inbound webhook and signs
# outbound deliveries in modules/application/dispatch_worker.py.
BAOBAB_EVENT_SIGNING_SECRET=change-me-event-signing-secret
# Where dispatch_worker.py POSTs outbound canonical events; deployment configuration.
BAOBAB_WEBHOOK_URL=https://change-me.example.com/baobab/events
# How often the baobab-dispatch-worker Compose service invokes dispatch_worker.py.
BAOBAB_DISPATCH_INTERVAL_SECONDS=60
DATABASE_URL=postgresql://adempiere:change-me-database@localhost:5432/idempiere
# Gate IAM-10 (ADR-0014 §111): baobab-app validates every /context/resolve*|
# /mapping/resolve* caller's bearer token against this Baobab IAM realm's JWKS.
BAOBAB_IAM_OIDC_ISSUER=https://change-me.example.com/realms/baobab
BAOBAB_IAM_OIDC_AUDIENCE=baobab-erp

# Canonical EngineInstance used for idempotent ERP projection mappings.
BAOBAB_ERP_ENGINE_INSTANCE_ID=erp-zuribeans
